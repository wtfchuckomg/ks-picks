rules_version = '2';

// Friday Night Picks — Firestore security rules.
//
// These are what actually enforce the two rules of the pool:
//   1. Nobody can write a pick after the week's deadline. The check uses
//      request.time (the server's clock), so changing the clock on a phone
//      does nothing.
//   2. Nobody can read anyone else's picks. Players read only their own
//      card; the commissioner reads them all.
//
// Keep the email list below identical to ADMIN_EMAILS in index.html.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['chuck8303@gmail.com'];
    }

    // The commissioner's Unlock switch: while it's on every bracket is open, whatever the locks below say.
    function bkUnlocked() {
      return get(/databases/$(database)/documents/bracketMeta/po26).data.get('unlocked', false) == true;
    }

    function week(wid) {
      return get(/databases/$(database)/documents/weeks/$(wid)).data;
    }

    // ---- Roster -------------------------------------------------------
    // A record now carries the Google address it belongs to, so it is NOT
    // public. You can read your own record; the commissioner reads them all.
    // Names still appear publicly in the standings, which live in /scores.
    match /players/{playerId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.email == request.auth.token.email);

      // Claiming: only the account whose address the commissioner assigned,
      // and only to point the record at itself. Nothing else may change.
      allow update: if isAdmin()
                    || (signedIn()
                        && request.auth.token.email_verified == true
                        && resource.data.email == request.auth.token.email
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.uid == request.auth.uid);

      // A first-time player creates their own record, tied to their address.
      allow create: if isAdmin()
                    || (signedIn()
                        && request.auth.token.email_verified == true
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.id == playerId
                        && request.resource.data.name is string
                        && request.resource.data.name.size() <= 40);

      allow delete: if isAdmin();
    }

    // ---- Team library (names, logos, colours) --------------------------
    // Everyone reads it so logos render; only the commissioner edits it.
    match /teams/{teamId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- Weeks and games ---------------------------------------------
    // The slate is public — anyone can look without signing in. Only the
    // commissioner writes it, which also means only the commissioner can
    // move a deadline.
    match /weeks/{weekId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- Playoff bracket challenge (2026) -----------------------------
    // Each game locks at 5:00 PM on its day: week 9's Thursday games at 5 PM
    // Thursday the 29th, everything else at 5 PM Friday the 30th (22:00 UTC).
    // index.html has the same moments (BK_LOCK_THU, BK_LOCK) and the same
    // Thursday list (BK_THU). Your bracket is yours alone until the Friday lock;
    // after it every bracket is public, so the standings can be added up.
    match /brackets/{bracketId} {
      function bkThuLock() { return timestamp.date(2026, 10, 30) + duration.value(1095, 'm'); }
      function bkLock()    { return timestamp.date(2026, 10, 30) + duration.value(22, 'h'); }
      function bkThuGames() {
        return ['6A_0_3', '6A_0_4', '6A_0_6', '5A_0_4', '5A_0_13', '4A_0_12', '4A_0_13', '2A_0_0', '2A_0_2', '2A_0_4', '2A_0_6', '2A_0_12', '1A_0_2', '1A_0_6', '1A_0_10', '1A_0_12', '8M-I_0_0', '8M-I_0_2', '8M-I_0_3', '8M-I_0_4', '8M-I_0_5', '8M-I_0_6', '8M-I_0_7', '8M-I_0_8', '8M-I_0_9', '8M-I_0_10', '8M-I_0_11', '8M-I_0_12', '8M-I_0_13', '8M-I_0_14', '8M-I_0_15', '8M-II_0_0', '8M-II_0_1', '8M-II_0_2', '8M-II_0_4', '8M-II_0_5', '8M-II_0_6', '8M-II_0_7', '8M-II_0_8', '8M-II_0_9', '8M-II_0_10', '8M-II_0_11', '8M-II_0_12', '8M-II_0_13', '8M-II_0_14', '6M_0_2', '6M_0_3', '6M_0_6', '6M_0_7', '6M_0_10', '6M_0_11', '6M_0_15'];
      }
      function bkValid(id) {
        return signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.bracketId == 'po26'
          // Bracket 1 is po26__<player>; a player's 2nd to 5th are po26__<player>__2 … __5.
          && request.resource.data.slot is int
          && request.resource.data.slot >= 1 && request.resource.data.slot <= 5
          && id == 'po26__' + request.resource.data.playerId
                   + (request.resource.data.slot == 1 ? '' : '__' + string(request.resource.data.slot))
          && request.resource.data.nick is string
          && request.resource.data.nick.size() <= 30
          && request.resource.data.picks is map
          && request.resource.data.picks.size() <= 300
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && (request.time < bkLock() || bkUnlocked());
      }

      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid)
                  || request.time >= bkLock();

      // After Thursday's lock a new bracket can't include a Thursday game...
      allow create: if isAdmin()
        || (bkValid(bracketId)
            && (request.time < bkThuLock() || bkUnlocked()
                || !request.resource.data.picks.keys().hasAny(bkThuGames())));

      // ...and a saved one can't change one. Only the owner may update.
      allow update: if isAdmin()
        || (bkValid(bracketId)
            && resource.data.uid == request.auth.uid
            && (request.time < bkThuLock() || bkUnlocked()
                || !request.resource.data.picks.diff(resource.data.picks).affectedKeys().hasAny(bkThuGames())));

      allow delete: if isAdmin();
    }

    // Each bracket's picks with no name on them, for the People's Bracket,
    // which everyone can see. Filed under the account's id (and __2 … __5 for
    // a player's other brackets); only that account
    // (or the commissioner) writes it, and only until the Friday lock.
    match /bracketVotes/{vid} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (signedIn()
            && (vid == request.auth.uid || vid.matches(request.auth.uid + '__[2-5]'))
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.bracketId == 'po26'
            && request.resource.data.picks is map
            && request.resource.data.picks.size() <= 300
            && (request.time < timestamp.date(2026, 10, 30) + duration.value(22, 'h') || bkUnlocked()));
      allow delete: if isAdmin();
    }

    // Results the commissioner sets by hand. Everyone reads them.
    match /bracketMeta/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- Picks (private) ----------------------------------------------
    match /picks/{pickId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid);

      allow create, update: if isAdmin()
        || (signedIn()
            && request.resource.data.uid == request.auth.uid
            && pickId == request.resource.data.weekId + '__' + request.resource.data.playerId
            && request.resource.data.picks is map
            && request.resource.data.picks.size() <= 40
            && week(request.resource.data.weekId).published == true
            && request.time < week(request.resource.data.weekId).deadline);

      allow delete: if isAdmin();
    }

    // ---- Scores (public totals only, never the picks themselves) -------
    // Standings are public. These carry names and counts, never picks.
    match /scores/{scoreId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Anything not matched above is denied by default.
  }
}
